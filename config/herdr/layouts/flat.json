{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.9"
  },
  "type": "row",
  "titlebar": "none",
  "preview": "layouts/flat.svg",
  "background": "canvas",
  "terminal_padding": [14, 12],
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": { "px": 268 },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "children": [
        { "id": "spaces", "type": "block", "content": { "mod": "flat-sidebar" } }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "work-body",
          "type": "row",
          "divider": { "width": 1, "color": "border" },
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 0,
                  "radius": 0,
                  "background": "background",
                  "lone": true,
                  "border": { "width": 1, "color": "#00000000" },
                  "focus": { "width": 1, "color": "dim" }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": { "px": 368 },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    { "id": "files", "type": "block", "content": { "mod": "files" } },
                    { "id": "changes", "type": "block", "content": { "mod": "changes" } }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tabs",
          "type": "block",
          "size": { "px": 32 },
          "window_drag": true,
          "content": { "mod": "flat-tabs" }
        }
      ]
    }
  ]
}
